# Signhify GTM Autopilot OS — environment variables (names only, no values).
# Copy to .env.local for local development. Never commit real values.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service-role key — SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key (free tier) — enables the Groq adapter in lib/llm.ts.
# Without any LLM key, the app uses the labelled deterministic baseline.
GROQ_API_KEY=

# Google Gemini API key (free tier) — enables the Gemini adapter in lib/llm.ts.
GEMINI_API_KEY=
